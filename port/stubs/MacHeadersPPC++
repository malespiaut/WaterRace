// Pomme's DrawPicture can't scale or clip, and its CopyBits doesn't damage the destination port:
// Boot.cp's versions replace them (PORTING.md 5.3, 6.3).
void Port_DrawPicture(PicHandle myPicture, const Rect* dstRect);
void Port_CopyBits(const PixMap* srcBits, PixMap* dstBits, const Rect* srcRect, const Rect* dstRect, short mode, void* maskRgn);
#define DrawPicture Port_DrawPicture
#define CopyBits Port_CopyBits

// Pomme's GetMouse returns window coordinates and doesn't pump events: Boot.cp's maps them to the 640x480 interface.
void Port_GetMouse(Point* mouseLoc);
#define GetMouse Port_GetMouse

// A Pomme picture (decoded ARGB32) from raw PICT data, as MetaFile 'imag' tags hold; nil if Pomme can't decode it (Boot.cp).
PicHandle Port_NewPictureFromPICT(Ptr data, long size);
// A Pomme picture from a PNG file (converted artwork, PORTING.md 5.3); nil if missing (Boot.cp).
PicHandle Port_NewPictureFromPNG(const char* path);

// Pomme exposes GetIndString as GetIndStringC (same arguments, Str255 out).
#define GetIndString(s, list, index) GetIndStringC((s), (list), (index))
// The Pascal string, for text the game measures by its length byte (Boot.cp).
void GetIndStringP(Str255 theString, short strListID, short index);
